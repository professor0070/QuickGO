# Ignore dependency directories
node_modules/
backend/node_modules/
web/admin_panel/node_modules/

# Ignore build outputs
dist/
build/
.next/
web/admin_panel/.next/
tsconfig.tsbuildinfo
web/admin_panel/tsconfig.tsbuildinfo

# Ignore local environment files and secrets
.env
.env.*
!.env.example
backend/.env
web/admin_panel/.env

# Ignore mobile application code (not used in docker builds)
mobile/

# Ignore version control and IDE files
.git/
.gitignore
.gitattributes
.vscode/
.idea/
.gemini/

# Ignore logs and temp files
*.log
*.tmp
*.bak
.DS_Store
Thumbs.db
