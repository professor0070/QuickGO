NODE_ENV=development
PORT=3000
APP_VERSION=0.1.0
DATABASE_URL=postgresql://quickgo:quickgo@localhost:5432/quickgo_dev
JWT_ACCESS_SECRET=replace-with-local-access-secret
JWT_REFRESH_SECRET=replace-with-local-refresh-secret
OTP_PROVIDER=mock
MOCK_OTP_CODE=123456
FCM_SERVER_KEY_OR_SERVICE_ACCOUNT=
