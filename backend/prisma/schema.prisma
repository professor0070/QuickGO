generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  CUSTOMER
  VENDOR_OWNER
  VENDOR_STAFF
  RIDER
  ADMIN
  SUPER_ADMIN
  SUPPORT
  ZONE_ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum OnboardingStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  ACTIVE
  PAUSED
  BLOCKED
  SUSPENDED
  TERMINATION_PENDING
  AGREEMENT_TERMINATED
  OFFBOARDED
  ARCHIVED
}

enum ProductCategoryCode {
  RESTAURANT_FOOD
  VEGETABLES
  FRUITS
  DAIRY
  MEAT
  FISH
}

enum OrderStatus {
  PLACED
  VENDOR_ACCEPTED
  PREPARING_OR_PACKING
  READY_FOR_PICKUP
  RIDER_ASSIGNED
  PICKED_UP
  DELIVERED
  PAYMENT_COLLECTED
  COMPLETED
  CUSTOMER_CANCELLED
  VENDOR_REJECTED
  ADMIN_CANCELLED
  RIDER_FAILED
  PAYMENT_PENDING
  REFUND_PENDING
  REFUNDED
  SUPPORT_REVIEW
  CANCELLED
}

enum PaymentMethod {
  COD
  UPI_ON_DELIVERY
  UPI
  RAZORPAY
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PENDING_COLLECTION
  COLLECTION_PENDING
  COLLECTED_UNVERIFIED
  COLLECTED
  VERIFIED
  SHORT_COLLECTED
  OVER_COLLECTED
  DISPUTED
  SETTLED
  RECONCILED
  FAILED
  REFUND_PENDING
  REFUNDED
  SUCCESS
  PROCESSING
}

enum CollectorType {
  RIDER
  VENDOR
  ADMIN
  QUICKGO_ADMIN
  QUICKGO_QR
}

enum PaymentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ReconciliationAlertType {
  COLLECTION_PENDING
  AMOUNT_MISMATCH
  PAYMENT_DISPUTE
}

enum ReconciliationAlertStatus {
  OPEN
  RESOLVED
}

enum ComplianceStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum DeliveryProofStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

enum FssaiStatus {
  FSSAI_PENDING
  FSSAI_VERIFIED
  FSSAI_EXPIRED
  FSSAI_REJECTED
  FSSAI_NOT_APPLICABLE_REVIEW_REQUIRED
}

enum VendorStaffRole {
  OWNER
  STAFF
}

enum VendorStaffStatus {
  ACTIVE
  REMOVED
}

enum PayoutStatus {
  PAYOUT_NOT_DUE
  PAYOUT_PENDING
  PAYOUT_PARTIAL
  PAYOUT_PAID
  PAYOUT_HOLD
  PAYOUT_DISPUTED
}

enum PayoutPayeeType {
  VENDOR
  RIDER
}

enum TicketStatus {
  OPEN
  IN_REVIEW
  IN_PROGRESS
  WAITING_FOR_VENDOR
  WAITING_FOR_RIDER
  RESOLVED
  REJECTED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PrivacyRequestStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  REJECTED
}

model User {
  id              String           @id @default(uuid())
  phone           String           @unique
  name            String?
  email           String?
  isPhoneVerified Boolean          @default(false)
  status          UserStatus       @default(ACTIVE)
  avatarUrl       String?
  avatarStorageKey String?
  avatarMimeType   String?
  avatarSizeBytes  Int?
  avatarUpdatedAt  DateTime?
  customerAvatarUrl        String?
  customerAvatarStorageKey String?
  customerAvatarMimeType   String?
  customerAvatarSizeBytes  Int?
  customerAvatarUpdatedAt  DateTime?
  partnerAvatarUrl         String?
  partnerAvatarStorageKey  String?
  partnerAvatarMimeType    String?
  partnerAvatarSizeBytes   Int?
  partnerAvatarUpdatedAt   DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  roles           UserRole[]
  otpSessions     OtpSession[]
  customer        Customer?
  vendorStaff     VendorStaff[]
  rider           Rider?
  auditLogs       AuditLog[]       @relation("ActorAuditLogs")
  consentRecords  ConsentRecord[]
  privacyRequests PrivacyRequest[]
  notifications   Notification[]

  @@index([phone])
  @@index([status])
  @@index([deletedAt])
}

model Role {
  id          String     @id @default(uuid())
  code        RoleCode   @unique
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  users       UserRole[]
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String
  roleId     String
  assignedBy String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  role       Role     @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([roleId])
  @@index([assignedBy])
}

model OtpSession {
  id         String    @id @default(uuid())
  userId     String?
  phone      String
  purpose    String
  codeHash   String?
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User?     @relation(fields: [userId], references: [id])

  @@index([phone, purpose, createdAt])
}

model Customer {
  id        String     @id @default(uuid())
  userId    String     @unique
  name      String?
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id])
  addresses Address[]
  carts     Cart[]
  orders    Order[]
  wallet    Wallet?
  odysseyProfile OdysseyProfile?
}

model Address {
  id            String   @id @default(uuid())
  customerId    String
  receiverName  String
  receiverPhone String
  line1         String
  line2         String?
  city          String
  state         String
  pincode       String?
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  customer      Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

model Vendor {
  id               String                     @id @default(uuid())
  shopName         String
  legalName        String?
  ownerName        String
  ownerPhone       String
  categoryCode     ProductCategoryCode
  serviceZoneId    String
  addressLine      String
  city             String
  state            String
  latitude         Decimal?                   @db.Decimal(10, 7)
  longitude        Decimal?                   @db.Decimal(10, 7)
  isOpen           Boolean                    @default(false)
  status           OnboardingStatus           @default(PENDING)
  onboardingStatus OnboardingStatus           @default(PENDING)
  fssaiStatus      FssaiStatus                @default(FSSAI_PENDING)
  commissionRate   Decimal                    @default(0) @db.Decimal(5, 2)
  openingHours     Json?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  deletedAt        DateTime?
  serviceZone      ServiceZone                @relation(fields: [serviceZoneId], references: [id])
  staff            VendorStaff[]
  documents        VendorComplianceDocument[]
  products         Product[]
  orders           Order[]
  settlements      Settlement[]
  payouts          VendorPayout[]
  payoutRecords    Payout[]
  bankDetails      BankDetails?

  @@index([serviceZoneId, isOpen])
  @@index([status, fssaiStatus])
  @@index([onboardingStatus])
  @@index([ownerPhone])
  @@index([deletedAt])
}

model VendorStaff {
  id        String            @id @default(uuid())
  vendorId  String
  userId    String
  role      VendorStaffRole   @default(OWNER)
  status    VendorStaffStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  vendor    Vendor            @relation(fields: [vendorId], references: [id])
  user      User              @relation(fields: [userId], references: [id])

  @@unique([vendorId, userId])
  @@index([userId])
  @@index([status])
}

model VendorComplianceDocument {
  id          String           @id @default(uuid())
  vendorId    String
  type        String
  documentUrl String
  status      ComplianceStatus @default(PENDING)
  expiresAt              DateTime?
  documentNumberMasked   String?
  documentNumberEncrypted String?
  originalFileName       String?
  mimeType               String?
  sizeBytes              Int?
  checksum               String?
  rejectionReason        String?
  reviewedAt             DateTime?
  reviewedByAdminId      String?
  supersededByDocumentId String?
  revokedAt              DateTime?
  archivedAt             DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  vendor                 Vendor           @relation(fields: [vendorId], references: [id])

  @@index([vendorId, status])
}

model Rider {
  id               String               @id @default(uuid())
  userId           String               @unique
  name             String
  phone            String
  vehicleType      String?
  vehicleNumber    String?
  serviceZoneId    String
  isOnline         Boolean              @default(false)
  status           OnboardingStatus     @default(PENDING)
  onboardingStatus OnboardingStatus     @default(PENDING)
  payoutUpiId      String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deletedAt        DateTime?
  user             User                 @relation(fields: [userId], references: [id])
  serviceZone      ServiceZone          @relation(fields: [serviceZoneId], references: [id])
  kycDocuments     RiderKycDocument[]
  assignments      DeliveryAssignment[]
  deliveryProofs   DeliveryProof[]
  payouts          RiderPayout[]
  payoutRecords    Payout[]
  bankDetails      BankDetails?

  @@index([serviceZoneId, isOnline])
  @@index([status])
  @@index([onboardingStatus])
  @@index([phone])
  @@index([deletedAt])
}

model RiderKycDocument {
  id          String           @id @default(uuid())
  riderId     String
  type        String
  documentUrl String
  status                 ComplianceStatus @default(PENDING)
  documentNumberMasked   String?
  documentNumberEncrypted String?
  originalFileName       String?
  mimeType               String?
  sizeBytes              Int?
  checksum               String?
  rejectionReason        String?
  reviewedAt             DateTime?
  reviewedByAdminId      String?
  supersededByDocumentId String?
  revokedAt              DateTime?
  archivedAt             DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  rider                  Rider            @relation(fields: [riderId], references: [id])

  @@index([riderId, status])
}

model ServiceZone {
  id              String   @id @default(uuid())
  name            String
  city            String
  state           String
  centerLatitude  Decimal  @db.Decimal(10, 7)
  centerLongitude Decimal  @db.Decimal(10, 7)
  radiusKm              Decimal                 @default(3.0) @db.Decimal(5, 2)
  isActive              Boolean                 @default(true)
  status                String                  @default("ACTIVE")
  polygonJson           String?
  operatingHours        String?
  createdBySuperAdminId String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  vendors               Vendor[]
  riders                Rider[]
  orders                Order[]
  pincodes              ServiceZonePincode[]
  adminAssignments      AdminZoneAssignment[]
  partnerAssignments    PartnerZoneAssignment[]

  @@index([city, isActive])
}

model Category {
  id        String              @id @default(uuid())
  code      ProductCategoryCode @unique
  name      String
  sortOrder Int                 @default(0)
  isFresh   Boolean             @default(false)
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  products  Product[]
}

model Product {
  id              String           @id @default(uuid())
  vendorId        String
  categoryId      String
  name            String
  description     String?
  imageUrl        String?
  imageStorageKey String?
  imageMimeType   String?
  imageSizeBytes  Int?
  imageUpdatedAt DateTime?
  unit            String
  productType     String           @default("FOOD")
  isStockManaged  Boolean          @default(false)
  isApproved      Boolean          @default(false)
  isAvailable     Boolean          @default(true)
  approvalStatus  OnboardingStatus @default(PENDING)
  createdBy       String?
  approvedBy      String?
  mrp             Decimal          @default(0) @db.Decimal(10, 2)
  margin          Decimal          @default(0) @db.Decimal(10, 2)
  shelfLifeDays   Int?
  freshnessStatus String           @default("FRESH")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  vendor          Vendor           @relation(fields: [vendorId], references: [id])
  category        Category         @relation(fields: [categoryId], references: [id])
  prices          ProductPrice[]
  cartItems       CartItem[]
  orderItems      OrderItem[]

  @@index([vendorId, isAvailable])
  @@index([categoryId])
  @@index([approvalStatus])
  @@index([deletedAt])
}

model ProductPrice {
  id          String   @id @default(uuid())
  productId   String
  price       Decimal  @db.Decimal(10, 2)
  mrp         Decimal  @default(0) @db.Decimal(10, 2)
  effectiveOn DateTime @default(now())
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id])

  @@index([productId, isActive])
  @@index([effectiveOn])
}

model Cart {
  id         String     @id @default(uuid())
  customerId String
  vendorId   String?
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  customer   Customer   @relation(fields: [customerId], references: [id])
  items      CartItem[]

  @@index([customerId, isActive])
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart     @relation(fields: [cartId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}

model Order {
  id                          String                       @id @default(uuid())
  orderNumber                 String                       @unique
  customerId                  String
  vendorId                    String
  riderId                     String?
  serviceZoneId               String
  status                      OrderStatus                  @default(PLACED)
  paymentMethod               PaymentMethod
  paymentStatus               PaymentStatus                @default(PENDING_COLLECTION)
  itemTotal                   Decimal                      @db.Decimal(10, 2)
  deliveryFee                 Decimal                      @db.Decimal(10, 2)
  platformFee                 Decimal                      @default(0) @db.Decimal(10, 2)
  discountAmount              Decimal                      @default(0) @db.Decimal(10, 2)
  totalAmount                 Decimal                      @db.Decimal(10, 2)
  commissionRateSnapshot      Decimal                      @default(0) @db.Decimal(5, 2)
  commissionAmount            Decimal                      @default(0) @db.Decimal(10, 2)
  customerSnapshot            Json
  vendorSnapshot              Json
  deliveryAddressSnapshot     Json
  paymentSnapshot             Json?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  acceptedAt                  DateTime?
  readyAt                     DateTime?
  assignedAt                  DateTime?
  pickedAt                    DateTime?
  deliveredAt                 DateTime?
  completedAt                 DateTime?
  cancelledAt                 DateTime?
  cancellationReason          String?
  customer                    Customer                     @relation(fields: [customerId], references: [id])
  vendor                      Vendor                       @relation(fields: [vendorId], references: [id])
  serviceZone                 ServiceZone                  @relation(fields: [serviceZoneId], references: [id])
  items                       OrderItem[]
  history                     OrderStatusHistory[]
  deliveryAssignments         DeliveryAssignment[]
  payments                    Payment[]
  collections                 PaymentCollection[]
  supportTickets              SupportTicket[]
  slaEvents                   SlaEvent[]
  deliveryProofs              DeliveryProof[]
  paymentReconciliationEvents PaymentReconciliationEvent[]
  paymentReconciliationAlerts PaymentReconciliationAlert[]
  invoiceReceipt              InvoiceReceipt?
  substitutions               OrderSubstitution[]
  foodSafetyIncidents         FoodSafetyIncident[]

  @@index([customerId, createdAt])
  @@index([vendorId, status])
  @@index([riderId, status])
  @@index([serviceZoneId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
}

model OrderItem {
  id                  String   @id @default(uuid())
  orderId             String
  productId           String?
  productSnapshot     Json
  productNameSnapshot String?
  productUnitSnapshot String?
  unitPriceSnapshot   Decimal? @db.Decimal(10, 2)
  quantity            Int
  orderedQuantity     Decimal? @db.Decimal(10, 3)
  fulfilledQuantity   Decimal? @db.Decimal(10, 3)
  unitPrice           Decimal  @db.Decimal(10, 2)
  lineTotal           Decimal  @db.Decimal(10, 2)
  substitutionStatus  String?  @default("NONE")
  substitutionNote    String?
  order               Order    @relation(fields: [orderId], references: [id])
  product             Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model OrderStatusHistory {
  id         String       @id @default(uuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorId    String?
  reason     String?
  createdAt  DateTime     @default(now())
  order      Order        @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
}

model DeliveryAssignment {
  id          String    @id @default(uuid())
  orderId     String
  riderId     String
  assignedBy  String
  assignedAt  DateTime  @default(now())
  acceptedAt  DateTime?
  rejectedAt  DateTime?
  rejectionReason String?
  pickedAt    DateTime?
  deliveredAt DateTime?
  isActive    Boolean   @default(true)
  order       Order     @relation(fields: [orderId], references: [id])
  rider       Rider     @relation(fields: [riderId], references: [id])

  @@index([riderId, isActive])
  @@index([orderId, isActive])
}

model DeliveryProof {
  id        String              @id @default(uuid())
  orderId   String
  riderId   String?
  proofUrl  String?
  note      String?
  status    DeliveryProofStatus @default(SUBMITTED)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @default(now()) @updatedAt
  order     Order               @relation(fields: [orderId], references: [id])
  rider     Rider?              @relation(fields: [riderId], references: [id])

  @@index([orderId])
  @@index([riderId, createdAt])
  @@index([status, createdAt])
}

model Payment {
  id                      String                       @id @default(uuid())
  orderId                 String
  method                  PaymentMethod
  paymentMethodRequested  PaymentMethod?
  paymentMethodActual     PaymentMethod?
  collectorType           CollectorType?
  collectorId             String?
  status                  PaymentStatus                @default(PENDING_COLLECTION)
  adminVerificationStatus PaymentVerificationStatus    @default(PENDING)
  amount                  Decimal                      @db.Decimal(10, 2)
  amountCollected         Decimal                      @default(0) @db.Decimal(10, 2)
  collectionTimestamp     DateTime?
  paymentProofReference   String?
  gatewayOrderId          String?                      @unique
  gatewayPaymentId        String?
  gatewaySignature        String?
  webhookPayload          Json?
  errorReason             String?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  reconciledAt            DateTime?
  reconciledBy            String?
  order                   Order                        @relation(fields: [orderId], references: [id])
  reconciliationEvents    PaymentReconciliationEvent[]
  reconciliationAlerts    PaymentReconciliationAlert[]

  @@index([orderId])
  @@index([status, createdAt])
  @@index([adminVerificationStatus, createdAt])
  @@index([collectorType, collectorId])
}

model PaymentCollection {
  id            String        @id @default(uuid())
  orderId       String
  collectorType CollectorType
  collectorId   String
  amount        Decimal       @db.Decimal(10, 2)
  status        PaymentStatus @default(COLLECTED)
  collectedAt   DateTime      @default(now())
  reconciledAt  DateTime?
  note          String?
  order         Order         @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status, collectedAt])
}

model PaymentReconciliationEvent {
  id         String         @id @default(uuid())
  orderId    String
  paymentId  String?
  fromStatus PaymentStatus?
  toStatus   PaymentStatus
  amount     Decimal?       @db.Decimal(10, 2)
  note       String?
  createdBy  String?
  createdAt  DateTime       @default(now())
  order      Order          @relation(fields: [orderId], references: [id])
  payment    Payment?       @relation(fields: [paymentId], references: [id])

  @@index([orderId, createdAt])
  @@index([paymentId, createdAt])
  @@index([toStatus, createdAt])
}

model PaymentReconciliationAlert {
  id              String                    @id @default(uuid())
  orderId         String
  paymentId       String?
  type            ReconciliationAlertType
  status          ReconciliationAlertStatus @default(OPEN)
  severity        Priority                  @default(MEDIUM)
  expectedAmount  Decimal?                  @db.Decimal(10, 2)
  collectedAmount Decimal?                  @db.Decimal(10, 2)
  message         String
  metadata        Json?
  resolvedAt      DateTime?
  resolvedBy      String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  order           Order                     @relation(fields: [orderId], references: [id])
  payment         Payment?                  @relation(fields: [paymentId], references: [id])

  @@index([status, severity, createdAt])
  @@index([orderId, status])
  @@index([paymentId, status])
  @@index([type, status, createdAt])
}

model Commission {
  id        String   @id @default(uuid())
  vendorId  String
  orderId   String
  rate      Decimal  @db.Decimal(5, 2)
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  @@index([vendorId, createdAt])
}

model Settlement {
  id          String        @id @default(uuid())
  vendorId    String
  status      PaymentStatus @default(PENDING_COLLECTION)
  amount      Decimal       @db.Decimal(10, 2)
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime      @default(now())
  vendor      Vendor        @relation(fields: [vendorId], references: [id])

  @@index([vendorId, status])
}

model VendorPayout {
  id         String        @id @default(uuid())
  vendorId   String
  amount     Decimal       @db.Decimal(10, 2)
  status     PaymentStatus @default(PENDING_COLLECTION)
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  vendor     Vendor        @relation(fields: [vendorId], references: [id])

  @@index([vendorId, status])
}

model RiderPayout {
  id         String        @id @default(uuid())
  riderId    String
  amount     Decimal       @db.Decimal(10, 2)
  status     PaymentStatus @default(PENDING_COLLECTION)
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  rider      Rider         @relation(fields: [riderId], references: [id])

  @@index([riderId, status])
}

model Payout {
  id             String             @id @default(uuid())
  payeeType      PayoutPayeeType
  vendorId       String?
  riderId        String?
  status         PayoutStatus       @default(PAYOUT_NOT_DUE)
  amount         Decimal            @db.Decimal(10, 2)
  adjustmentNote String?
  approvedBy     String?
  approvedAt     DateTime?
  paidAt         DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  vendor         Vendor?            @relation(fields: [vendorId], references: [id])
  rider          Rider?             @relation(fields: [riderId], references: [id])
  adjustments    PayoutAdjustment[]

  @@index([payeeType, status])
  @@index([vendorId, status])
  @@index([riderId, status])
  @@index([createdAt])
}

model SupportTicket {
  id             String               @id @default(uuid())
  orderId        String?
  customerId     String?
  status         TicketStatus         @default(OPEN)
  priority       Priority             @default(MEDIUM)
  subject        String
  description    String
  createdBy      String
  adminNote      String?
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  deletedAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  order          Order?               @relation(fields: [orderId], references: [id])
  events         SupportTicketEvent[]

  @@index([status, priority])
  @@index([orderId])
  @@index([createdBy, createdAt])
  @@index([deletedAt])
}

model SupportTicketEvent {
  id        String        @id @default(uuid())
  ticketId  String
  actorId   String?
  message   String
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id])

  @@index([ticketId, createdAt])
}

model IncidentReport {
  id          String    @id @default(uuid())
  severity    Priority
  title       String
  description String
  status      String    @default("OPEN")
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
}

model Notification {
  id               String    @id @default(uuid())
  userId           String
  title            String
  body             String
  data             Json?
  channel          String    @default("IN_APP")
  deliveryStatus   String    @default("PENDING")
  deliveryAttempts Int       @default(0)
  deliveryError    String?
  deliveryMetadata Json?
  sentAt           DateTime?
  readAt           DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([deliveryStatus, createdAt])
}

model CustomerDevice {
  id         String   @id @default(uuid())
  customerId String
  fcmToken   String
  platform   String   @default("ANDROID")
  appVersion String?
  createdAt  DateTime @default(now())

  @@unique([fcmToken])
  @@index([customerId])
}

model RiderDevice {
  id         String   @id @default(uuid())
  riderId    String
  fcmToken   String
  platform   String   @default("ANDROID")
  appVersion String?
  createdAt  DateTime @default(now())

  @@unique([fcmToken])
  @@index([riderId])
}

model DeviceSession {
  id         String   @id @default(uuid())
  userId     String
  fcmToken   String?
  platform   String   @default("ANDROID")
  appVersion String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId, lastSeenAt])
}

model LegalDocument {
  id         String          @id @default(uuid())
  type       String
  version    String
  contentUrl String?
  content    String?
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  consents   ConsentRecord[]

  @@unique([type, version])
  @@index([type, isActive])
}

model ConsentRecord {
  id              String        @id @default(uuid())
  userId          String
  legalDocumentId String
  acceptedAt      DateTime      @default(now())
  ipAddress       String?
  user            User          @relation(fields: [userId], references: [id])
  legalDocument   LegalDocument @relation(fields: [legalDocumentId], references: [id])

  @@unique([userId, legalDocumentId])
}

model PrivacyRequest {
  id          String               @id @default(uuid())
  userId      String
  type        String
  status      PrivacyRequestStatus @default(OPEN)
  description String?
  adminNote   String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  user        User                 @relation(fields: [userId], references: [id])

  @@index([status, createdAt])
}

model AuditLog {
  id            String   @id @default(uuid())
  actorId       String?
  action        String
  entityType    String
  entityId      String?
  serviceZoneId String?
  reason        String?
  ipAddress     String?
  userAgent     String?
  metadata      Json?
  createdAt     DateTime @default(now())
  actor         User?    @relation("ActorAuditLogs", fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([serviceZoneId])
}

model AppVersion {
  id            String   @id @default(uuid())
  app           String
  platform      String   @default("ANDROID")
  minVersion    String
  latestVersion String
  forceUpdate   Boolean  @default(false)
  maintenance   Boolean  @default(false)
  message       String?
  createdAt     DateTime @default(now())

  @@unique([app, platform])
}

model FeatureFlag {
  id        String   @id @default(uuid())
  key       String   @unique
  enabled   Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DailyClosingReport {
  id         String   @id @default(uuid())
  reportDate DateTime @unique
  metrics    Json
  notes      String?
  createdAt  DateTime @default(now())
}

model ReleaseNote {
  id        String   @id @default(uuid())
  version   String
  app       String
  notes     String
  createdAt DateTime @default(now())
}

model SlaEvent {
  id         String    @id @default(uuid())
  orderId    String
  type       String
  breached   Boolean   @default(false)
  metadata   Json?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  order      Order     @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
  @@index([breached, createdAt])
  @@index([type, breached, resolvedAt, createdAt])
}

model IdempotencyKey {
  id          String   @id @default(uuid())
  key         String   @unique
  scope       String
  status      String
  requestHash String?
  response    Json?
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([scope, createdAt])
}

model OrderSubstitution {
  id                   String   @id @default(uuid())
  orderId              String
  orderItemId          String
  originalProductId    String
  substitutedProductId String
  requestedQuantity    Decimal  @db.Decimal(10, 3)
  fulfilledQuantity    Decimal  @db.Decimal(10, 3)
  status               String   @default("PENDING") // PENDING, APPROVED, REJECTED
  note                 String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  order                Order    @relation(fields: [orderId], references: [id])
}

model OrderItemQualityIssue {
  id          String   @id @default(uuid())
  orderItemId String
  reportedBy  String
  category    String // e.g., DAMAGED, SPOILED, WRONG_ITEM
  description String
  status      String   @default("OPEN") // OPEN, IN_REVIEW, RESOLVED, REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ComplianceAuditEvent {
  id          String   @id @default(uuid())
  entityType  String // e.g., VENDOR, RIDER
  entityId    String
  action      String // e.g., VERIFIED_FSSAI, EXPIRED_FSSAI
  status      String
  performedBy String
  notes       String?
  createdAt   DateTime @default(now())
}

model FoodSafetyIncident {
  id          String    @id @default(uuid())
  orderId     String
  vendorId    String
  reportedBy  String
  severity    String // e.g., LOW, MEDIUM, HIGH, CRITICAL
  description String
  status      String    @default("OPEN") // OPEN, INVESTIGATING, RESOLVED, PENALIZED
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  order       Order     @relation(fields: [orderId], references: [id])
}

model PayoutAdjustment {
  id        String   @id @default(uuid())
  payoutId  String
  amount    Decimal  @db.Decimal(10, 2)
  type      String // e.g., PENALTY, BONUS, REIMBURSEMENT
  reason    String
  createdAt DateTime @default(now())
  payout    Payout   @relation(fields: [payoutId], references: [id])
}

model InvoiceReceipt {
  id            String   @id @default(uuid())
  orderId       String   @unique
  invoiceNumber String   @unique
  pdfUrl        String?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  order         Order    @relation(fields: [orderId], references: [id])
}

model ServiceZonePincode {
  id            String      @id @default(uuid())
  serviceZoneId String
  pincode       String
  isPrimary     Boolean     @default(true)
  createdAt     DateTime    @default(now())
  serviceZone   ServiceZone @relation(fields: [serviceZoneId], references: [id])

  @@unique([serviceZoneId, pincode])
  @@index([pincode])
}

model AdminZoneAssignment {
  id                     String      @id @default(uuid())
  adminUserId            String
  serviceZoneId          String
  status                 String      @default("PENDING") // PENDING, APPROVED, REJECTED, SUSPENDED, ACTIVE, REVOKED
  assignedBySuperAdminId String
  assignedAt             DateTime    @default(now())
  revokedAt              DateTime?
  revocationReason       String?
  serviceZone            ServiceZone @relation(fields: [serviceZoneId], references: [id])

  @@index([adminUserId])
  @@index([serviceZoneId])
}

model PartnerZoneAssignment {
  id            String      @id @default(uuid())
  partnerUserId String
  partnerType   String      // VENDOR, RIDER
  serviceZoneId String
  status        String      @default("ACTIVE") // ACTIVE, REVOKED
  assignedBy    String
  assignedAt    DateTime    @default(now())
  revokedAt     DateTime?
  serviceZone   ServiceZone @relation(fields: [serviceZoneId], references: [id])

  @@index([partnerUserId])
  @@index([serviceZoneId])
}

model BankDetails {
  id                String   @id @default(uuid())
  vendorId          String?  @unique
  riderId           String?  @unique
  accountHolderName String
  accountNumber     String
  ifsc              String
  bankName          String?
  branch            String?
  upiId             String?
  proofDocumentUrl  String?
  status            String   @default("PENDING") // PENDING, VERIFIED, REJECTED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  vendor            Vendor?  @relation(fields: [vendorId], references: [id])
  rider             Rider?   @relation(fields: [riderId], references: [id])
}

model BankDetailVersion {
  id                String    @id @default(uuid())
  vendorId          String?
  riderId           String?
  accountHolderName String
  accountNumber     String
  ifsc              String
  bankName          String?
  branch            String?
  upiId             String?
  proofDocumentUrl  String?
  status            String    @default("PENDING_REVIEW") // PENDING_REVIEW, APPROVED, REJECTED, SUPERSEDED
  rejectionReason   String?
  reviewedByAdminId String?
  reviewedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([vendorId])
  @@index([riderId])
}

model Wallet {
  id              String              @id @default(uuid())
  customerId      String              @unique
  coinsBalance    Int                 @default(0)
  cashbackBalance Decimal             @default(0.00) @db.Decimal(10, 2)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  customer        Customer            @relation(fields: [customerId], references: [id])
  transactions    WalletTransaction[]
}

model WalletTransaction {
  id          String    @id @default(uuid())
  walletId    String
  type        String    // e.g. GO_COINS_CREDIT, GO_COINS_DEBIT, GO_COINS_EXPIRED, CASHBACK_CREDIT, CASHBACK_DEBIT, CASHBACK_EXPIRED
  amount      Decimal   @db.Decimal(10, 2)
  currency    String    // e.g. COINS, CASHBACK
  referenceId String?
  orderId     String?
  description String?
  createdAt   DateTime  @default(now())
  expiryAt    DateTime?
  wallet      Wallet    @relation(fields: [walletId], references: [id])

  @@index([walletId])
}

model Reward {
  id          String        @id @default(uuid())
  customerId  String
  type        String        // e.g. INITIAL_REWARD, MILESTONE_REWARD
  rewardType  String        // e.g. COINS, CASHBACK, DISCOUNT
  rewardValue Decimal       @db.Decimal(10, 2)
  status      String        // LOCKED, AVAILABLE, REVEAL_REQUIRED, REVEALED, CLAIMABLE, CLAIMED, EXPIRED
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  claimedAt   DateTime?
  expiryAt    DateTime?
  claims      RewardClaim[]

  @@index([customerId])
}

model RewardClaim {
  id          String   @id @default(uuid())
  rewardId    String
  customerId  String
  amount      Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  reward      Reward   @relation(fields: [rewardId], references: [id])

  @@index([rewardId])
}

model OdysseyProfile {
  id         String         @id @default(uuid())
  customerId String         @unique
  points     Int            @default(0)
  level      Int            @default(1)
  streak     Int            @default(0)
  cycleCount Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  customer   Customer       @relation(fields: [customerId], references: [id])
  events     OdysseyEvent[]
}

model OdysseyEvent {
  id           String         @id @default(uuid())
  profileId    String
  type         String         // e.g. ORDER_COMPLETED, ORDER_CANCELLED, MILESTONE_REACHED
  pointsChange Int            @default(0)
  referenceId  String?
  createdAt    DateTime       @default(now())
  profile      OdysseyProfile @relation(fields: [profileId], references: [id])

  @@index([profileId])
  @@index([referenceId])
}

